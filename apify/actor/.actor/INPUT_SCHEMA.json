{
    "actorInputSchemaVersion": 1,
    "title": "ServiceOrdered Scraper Input",
    "type": "object",
    "schemaVersion": 1,
    "properties": {
        "webhookUrl": {
            "title": "Webhook URL",
            "type": "string",
            "editor": "textfield",
            "description": "Your ServiceOrdered webhook endpoint",
            "default": "https://serviceordered.com/api/webhook.php"
        },
        "webhookSecret": {
            "title": "Webhook Secret Token",
            "type": "string",
            "editor": "textfield",
            "description": "Secret token for webhook authentication",
            "isSecret": true
        },
        "maxPerSearch": {
            "title": "Max Results Per Search",
            "type": "integer",
            "editor": "number",
            "description": "Maximum listings per category and city combination",
            "default": 20,
            "minimum": 1,
            "maximum": 100
        },
        "categories": {
            "title": "Categories to Scrape",
            "type": "array",
            "editor": "stringList",
            "description": "Leave empty to use all 50 default categories",
            "items": { "type": "string" }
        },
        "cities": {
            "title": "Cities to Scrape",
            "type": "array",
            "editor": "json",
            "description": "Leave empty to use top 100 US cities. Each item: {name, state, abbr}",
            "items": { "type": "object" }
        }
    }
}
